diff --git a/server/src/lib/tools/builtin/provider-http.ts b/server/src/lib/tools/builtin/provider-http.ts
new file mode 100644
index 0000000..255e5b9
--- /dev/null
+++ b/server/src/lib/tools/builtin/provider-http.ts
@@ -0,0 +1,81 @@
+/**
+ * provider-http.ts — shared HTTP helpers for provider-backed builtin tools.
+ *
+ * The provider tools (send_email / im_read / im_send / github_* / *_generate)
+ * all follow the web-search.ts contract:
+ *   - provider selected via env vars at runtime, nothing bundled;
+ *   - unconfigured → structured stub so the LLM knows no real call happened;
+ *   - 30s timeout combined with the runtime's AbortSignal;
+ *   - network errors surfaced as `isError: true`, never thrown at the loop.
+ *
+ * This module holds the two bits of shared plumbing: the combined abort
+ * signal and a minimal JSON fetch that keeps every tool's input type free of
+ * DOM lib dependencies (server tsconfig may not include RequestInit).
+ */
+
+import type { BuiltinToolContext } from './types';
+
+export const DEFAULT_PROVIDER_TIMEOUT_MS = 30_000;
+
+/** Combine the runtime signal with a hard timeout. */
+export function providerSignal(
+  ctx: BuiltinToolContext,
+  timeoutMs: number = DEFAULT_PROVIDER_TIMEOUT_MS,
+): AbortSignal {
+  return AbortSignal.any([ctx.signal, AbortSignal.timeout(timeoutMs)]);
+}
+
+export interface ProviderRequestInit {
+  method?: string;
+  headers?: Record<string, string>;
+  body?: string;
+}
+
+export interface ProviderJsonResponse {
+  status: number;
+  /** Parsed JSON body, or the raw text when the response is not JSON. */
+  data: unknown;
+  /** True when the response body was not valid JSON. */
+  nonJson: boolean;
+}
+
+/**
+ * Fetch `url` and parse the response. Does NOT throw on HTTP error status —
+ * the caller decides how to frame non-2xx. Throws only on network failure /
+ * abort (callers wrap in try/catch like web-search.ts does).
+ */
+export async function providerFetchJson(
+  url: string,
+  init: ProviderRequestInit,
+  ctx: BuiltinToolContext,
+  timeoutMs?: number,
+): Promise<ProviderJsonResponse> {
+  const signal = providerSignal(ctx, timeoutMs);
+  const res = await fetch(url, { ...init, signal });
+  const text = await res.text();
+  try {
+    return { status: res.status, data: JSON.parse(text), nonJson: false };
+  } catch {
+    return { status: res.status, data: text, nonJson: true };
+  }
+}
+
+/** Read the env override from ctx when present (tests), else process.env. */
+export function providerEnv(
+  ctx: BuiltinToolContext,
+): Readonly<Record<string, string>> {
+  return ctx.env ?? (process.env as Record<string, string>);
+}
+
+/** Standard "no provider configured" stub shared by every provider tool. */
+export function providerStub(tool: string, note: string, extra?: Record<string, unknown>) {
+  return {
+    output: {
+      provider: 'stub',
+      tool,
+      ok: false,
+      note,
+      ...extra,
+    },
+  };
+}
diff --git a/server/src/lib/tools/builtin/send-email.ts b/server/src/lib/tools/builtin/send-email.ts
new file mode 100644
index 0000000..61c874b
--- /dev/null
+++ b/server/src/lib/tools/builtin/send-email.ts
@@ -0,0 +1,169 @@
+/**
+ * send-email.ts — builtin `send_email` tool.
+ *
+ * Default mode PROMPT (external side effect — every send is user-approved
+ * unless a skill whitelist explicitly opts in via listed→allow semantics).
+ *
+ * Provider selection (priority order), mirroring web-search.ts:
+ *   1. `RESEND_API_KEY`    — Resend HTTP API (https://api.resend.com/emails).
+ *                            Requires `SF_MAIL_FROM` as the from address.
+ *   2. `SF_MAIL_API_BASE`  — generic mail bridge: POST {base}/send with JSON
+ *                            { to, subject, text, html, attachments }.
+ *                            Optional `SF_MAIL_API_TOKEN` → Bearer auth.
+ *   3. (none)              — structured stub, no mail is sent.
+ */
+
+import type { ToolSpec } from '../../tool-spec';
+import type { BuiltinToolExecutor, BuiltinToolContext } from './types';
+import { providerEnv, providerFetchJson, providerStub } from './provider-http';
+
+export const sendEmailTool: ToolSpec = {
+  name: 'send_email',
+  description:
+    'Send an email. Provider is configured via RESEND_API_KEY (+SF_MAIL_FROM) or ' +
+    'SF_MAIL_API_BASE (generic bridge); without those configured returns a stub ' +
+    'and sends nothing. Attachments are base64-encoded.',
+  input_schema: {
+    type: 'object',
+    properties: {
+      to: {
+        oneOf: [
+          { type: 'string' },
+          { type: 'array', items: { type: 'string' } },
+        ],
+        description: 'Recipient address, or list of addresses.',
+      },
+      subject: { type: 'string', description: 'Email subject.' },
+      text: { type: 'string', description: 'Plain-text body.' },
+      html: { type: 'string', description: 'HTML body (optional).' },
+      attachments: {
+        type: 'array',
+        items: {
+          type: 'object',
+          properties: {
+            filename: { type: 'string' },
+            content: { type: 'string', description: 'Base64-encoded file content.' },
+          },
+          required: ['filename', 'content'],
+          additionalProperties: false,
+        },
+        description: 'Optional base64 attachments.',
+      },
+    },
+    required: ['to', 'subject'],
+    additionalProperties: false,
+  },
+  source: 'base',
+};
+
+interface MailAttachment {
+  filename: string;
+  content: string;
+}
+
+interface SendEmailInput {
+  to: string | string[];
+  subject: string;
+  text?: string;
+  html?: string;
+  attachments?: MailAttachment[];
+}
+
+function isSendEmailInput(x: unknown): x is SendEmailInput {
+  if (typeof x !== 'object' || x === null) return false;
+  const o = x as Record<string, unknown>;
+  const toOk =
+    typeof o.to === 'string' ||
+    (Array.isArray(o.to) && o.to.every((t) => typeof t === 'string' && t.length > 0));
+  return toOk && typeof o.subject === 'string' && o.subject.length > 0;
+}
+
+export const sendEmailExecutor: BuiltinToolExecutor = async (
+  input: unknown,
+  ctx: BuiltinToolContext,
+) => {
+  if (!isSendEmailInput(input)) {
+    return {
+      output: { error: 'send_email: input must be { to: string|string[], subject: string, text?, html?, attachments? }' },
+      isError: true,
+    };
+  }
+
+  const to = Array.isArray(input.to) ? input.to : [input.to];
+  const env = providerEnv(ctx);
+  const resendKey = env.RESEND_API_KEY;
+  const mailBase = env.SF_MAIL_API_BASE;
+
+  if (!resendKey && !mailBase) {
+    return providerStub(
+      'send_email',
+      'No mail provider configured (set RESEND_API_KEY + SF_MAIL_FROM, or SF_MAIL_API_BASE). No email was sent.',
+      { to, subject: input.subject },
+    );
+  }
+
+  try {
+    if (resendKey) {
+      const from = env.SF_MAIL_FROM;
+      if (!from) {
+        return {
+          output: {
+            error: 'send_email: RESEND_API_KEY is set but SF_MAIL_FROM (from address) is missing',
+          },
+          isError: true,
+        };
+      }
+      const res = await providerFetchJson(
+        'https://api.resend.com/emails',
+        {
+          method: 'POST',
+          headers: {
+            'content-type': 'application/json',
+            authorization: `Bearer ${resendKey}`,
+          },
+          body: JSON.stringify({
+            from,
+            to,
+            subject: input.subject,
+            text: input.text,
+            html: input.html,
+            attachments: input.attachments,
+          }),
+        },
+        ctx,
+      );
+      if (res.status >= 400) {
+        return { output: { error: `send_email: Resend ${res.status}`, detail: res.data }, isError: true };
+      }
+      const id = (res.data as { id?: string } | null)?.id;
+      return { output: { provider: 'resend', ok: true, id, to, subject: input.subject } };
+    }
+
+    // Generic mail bridge.
+    const base = mailBase!.replace(/\/+$/, '');
+    const headers: Record<string, string> = { 'content-type': 'application/json' };
+    if (env.SF_MAIL_API_TOKEN) headers.authorization = `Bearer ${env.SF_MAIL_API_TOKEN}`;
+    const res = await providerFetchJson(
+      `${base}/send`,
+      {
+        method: 'POST',
+        headers,
+        body: JSON.stringify({
+          to,
+          subject: input.subject,
+          text: input.text,
+          html: input.html,
+          attachments: input.attachments,
+        }),
+      },
+      ctx,
+    );
+    if (res.status >= 400) {
+      return { output: { error: `send_email: bridge ${res.status}`, detail: res.data }, isError: true };
+    }
+    return { output: { provider: 'http', ok: true, to, subject: input.subject, data: res.data } };
+  } catch (err) {
+    const msg = err instanceof Error ? err.message : String(err);
+    return { output: { error: `send_email failed: ${msg}` }, isError: true };
+  }
+};
