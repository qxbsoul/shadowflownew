diff --git a/server/src/storage/merchant-board.ts b/server/src/storage/merchant-board.ts
index e8d3c92..dc0b2c8 100644
--- a/server/src/storage/merchant-board.ts
+++ b/server/src/storage/merchant-board.ts
@@ -842,6 +842,184 @@ export function channelEconomics(input: { start?: unknown; end?: unknown } = {})
