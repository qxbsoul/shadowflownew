+    expect(parseOrchestratorPlan('{"intent":"task","strategy":"expert","tasks":[]}', AGENTS)).toBeNull();
+    expect(parseOrchestratorPlan('{"intent":"task","tasks":[{"agentId":"ghost","prompt":"p"}]}', AGENTS)).toBeNull();
