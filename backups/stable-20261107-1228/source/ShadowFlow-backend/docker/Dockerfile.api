# syntax=docker/dockerfile:1
# ShadowFlow Python / FastAPI backend.
# Multi-stage: builder installs dependencies; runtime contains only installed
# packages, application code and the declarative runtime data it reads.

FROM python:3.11.9-slim AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /build

# Copy metadata first so dependency installation stays cached across code edits.
COPY pyproject.toml README.md LICENSE ./
COPY shadowflow/__init__.py ./shadowflow/__init__.py
RUN pip install --prefix=/install ".[server]"

COPY shadowflow/ ./shadowflow/
RUN pip install --prefix=/install --no-deps .

FROM python:3.11.9-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/install/bin:${PATH}" \
    PYTHONPATH="/install/lib/python3.11/site-packages"

WORKDIR /app

RUN groupadd --system appgroup && useradd --system --gid appgroup appuser

COPY --from=builder /install /install
COPY shadowflow/ ./shadowflow/
COPY config/ ./config/
COPY templates/ ./templates/
COPY examples/runtime-contract/ ./examples/runtime-contract/
COPY .shadowflow/ ./.shadowflow/

RUN chown -R appuser:appgroup /app
USER appuser

EXPOSE 8000

CMD ["uvicorn", "shadowflow.server:app", "--host", "0.0.0.0", "--port", "8000"]
